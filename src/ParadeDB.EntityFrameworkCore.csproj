<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);EF1001;NPG9001;CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>ParadeDB.EntityFrameworkCore</PackageId>
    <Title>ParadeDB Entity Framework Core Integration</Title>
    <Description>The official Entity Framework Core integration for ParadeDB.</Description>
    <PackageTags>Aggregations;BM25;EntityFrameworkCore;EFCore;Faceted Search;Facets;Full Text Search;Hybrid Search;ParadeDB;Postgres;PostgreSQL;Search;Text Search;Vector Search</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
